<Application x:Class="BreathedgeCoopLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="Void">#050B10</Color><Color x:Key="Panel">#0C1720</Color><Color x:Key="PanelLight">#122531</Color>
    <Color x:Key="Accent">#FFB321</Color><Color x:Key="Cyan">#54D8F5</Color><Color x:Key="Text">#F2F7FA</Color>
    <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource Void}"/><SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}"/>
    <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource PanelLight}"/><SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource Cyan}"/><SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#071219"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#294656"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,10"/><Setter Property="FontSize" Value="14"/><Setter Property="CaretBrush" Value="{StaticResource CyanBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Shell" Property="Effect"><Setter.Value><DropShadowEffect Color="#4054D8F5" BlurRadius="8" ShadowDepth="0"/></Setter.Value></Setter></Trigger><Trigger Property="IsReadOnly" Value="True"><Setter Property="Foreground" Value="#B9CCD6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#122632"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#315061"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="17,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#1A3443"/><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource CyanBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="#161006"/><Setter Property="BorderBrush" Value="#FFD475"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="27,14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><Border.Effect><DropShadowEffect Color="#70FFB321" BlurRadius="15" ShadowDepth="0"/></Border.Effect><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#FFC54B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ModeChoice" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#8EA8B7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Background="#09151D" BorderBrush="#294656" BorderThickness="1" CornerRadius="5" Padding="18,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="Indicator" Width="8" Height="8" CornerRadius="4" Background="#49606D" Margin="0,0,11,0" VerticalAlignment="Center"/><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#4B7185"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="#152B35"/><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CyanBrush}"/><Setter TargetName="Indicator" Property="Background" Value="{StaticResource CyanBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
